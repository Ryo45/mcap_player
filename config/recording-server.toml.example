bind = "127.0.0.1:8081"

allowed_origins = [
  "http://localhost:8080",
]

max_in_flight_requests = 4

[limits]
default_window_ns = 2_000_000_000
max_window_ns = 5_000_000_000
default_response_bytes = 8_388_608
max_response_bytes = 67_108_864
default_max_messages = 50_000
max_messages = 200_000
max_chunk_bytes = 134_217_728

[[recordings]]
id = "turtlebot-demo"
display_name = "Turtlebot 7 Camera"
# Replace this absolute path with the mounted recording path on the server host.
path = "/mnt/recordings/turtlebot3_7cam_fhd_0.mcap"
